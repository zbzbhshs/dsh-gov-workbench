{
  "name": "dsh-gov-workbench",
  "version": "1.0.0",
  "type": "module",
  "description": "政务门户风格的 dsh Cordis 插件：在独立端口提供一个办事大厅界面，直接对接宿主的会话、模型与权限。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "gov",
    "workbench",
    "portal"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./bridge": "./lib/bridge.js",
    "./config": "./lib/config.js",
    "./host": "./lib/host.js",
    "./security": "./lib/security.js",
    "./static": "./lib/static.js",
    "./sse": "./lib/sse.js",
    "./transport": "./lib/transport.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "public",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
